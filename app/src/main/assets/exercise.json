   "harder": "Longer exhale",
   "seated": false,
   "jumping": false
  },
  {
   "id": "seated_march",
   "name": "Seated march",
   "howTo": "Sit tall at the edge of a chair, lift knees alternately and swing your arms.",
   "easier": "Arms only",
   "harder": "Faster pace",
   "seated": true,
   "jumping": false
  },
  {
   "id": "seated_leg_extension",
   "name": "Seated leg extension",
   "howTo": "Sit tall, straighten one knee, hold 2 seconds, lower. Alternate legs.",
   "easier": "Smaller range",
   "harder": "Hold longer",
   "seated": true,
   "jumping": false
  },
  {
   "id": "seated_twist",
   "name": "Seated torso twist",
   "howTo": "Sit tall, hand on the opposite knee, rotate gently. Switch sides.",
