   "harder": "Faster pace",
   "seated": false,
   "jumping": true
  },
  {
   "id": "jump_squat",
   "name": "Jump squat",
   "howTo": "Squat down, then jump up softly and land with bent knees.",
   "easier": "Regular squat",
   "harder": "Pause at the bottom",
   "seated": false,
   "jumping": true
  },
  {
   "id": "reach_fold",
   "name": "Reach and fold",
   "howTo": "Reach both arms up tall, then fold forward with soft knees and let your head hang.",
   "easier": "Fold only halfway",
   "harder": "Hold the fold longer",
   "seated": false,
   "jumping": false
  },
  {
   "id": "deep_breaths",
   "name": "Deep breaths",
   "howTo": "Breathe in slowly through your nose as you raise your arms, breathe out as you lower them.",
