   "jumping": false
  },
  {
   "id": "high_knee_march",
   "name": "High-knee march",
   "howTo": "March briskly, bringing knees up high and pumping your arms.",
   "easier": "Regular march",
   "harder": "Jog in place",
   "seated": false,
   "jumping": false
  },
  {
   "id": "squat",
   "name": "Squat",
   "howTo": "Feet hip-width, sit hips back as if onto a chair, knees follow toes, chest up.",
   "easier": "Sit-to-stand from a chair",
   "harder": "Slow 3-second lowering",
   "seated": false,
   "jumping": false
  },
  {
   "id": "sit_to_stand",
   "name": "Sit-to-stand",
   "howTo": "Sit at the edge of a chair, stand up tall without using your hands, sit back down slowly.",
   "easier": "Use your hands on your thighs",
   "harder": "Hold a water bottle at your chest",
   "seated": false,
   "jumping": false
  },
  {
   "id": "wall_pushup",
   "name": "Wall push-up",
   "howTo": "Hands on the wall at shoulder height, body straight, bend elbows to bring your chest to the wall.",
   "easier": "Stand closer to the wall",
   "harder": "Incline push-up on a table",
   "seated": false,
   "jumping": false
  },
  {
   "id": "incline_pushup",
   "name": "Incline push-up",
   "howTo": "Hands on a sturdy table or counter, body straight, lower your chest and push back up.",
   "easier": "Wall push-up",
   "harder": "Floor push-up",
   "seated": false,
   "jumping": false
  },
  {
   "id": "pushup",
   "name": "Push-up",
   "howTo": "Hands under shoulders, body straight from head to heels (or knees), lower and push up.",
   "easier": "Knees down",
   "harder": "Slower lowering",
   "seated": false,
   "jumping": false
  },
  {
   "id": "glute_bridge",
   "name": "Glute bridge",
   "howTo": "Lie on your back, knees bent, feet flat; squeeze glutes and lift hips; lower slowly.",
   "easier": "Smaller lift",
   "harder": "Single-leg bridge",
   "seated": false,
   "jumping": false
  },
  {
   "id": "bird_dog",
   "name": "Bird-dog",
   "howTo": "On hands and knees, extend opposite arm and leg, keep your back flat, switch sides.",
   "easier": "Extend only an arm or a leg",
   "harder": "Hold 5 seconds each side",
   "seated": false,
   "jumping": false
  },
  {
   "id": "dead_bug",
   "name": "Dead bug",
   "howTo": "On your back, arms up, knees bent at 90°; lower opposite arm and leg, keep lower back on the floor.",
   "easier": "Move only your legs",
   "harder": "Slower, fully extend",
   "seated": false,
   "jumping": false
  },
  {
   "id": "plank",
   "name": "Plank",
   "howTo": "Forearms on the floor, body in a straight line from head to heels, breathe steadily.",
   "easier": "Knees down, or hands on a table",
   "harder": "Lift one foot",
   "seated": false,
   "jumping": false
  },
  {
   "id": "reverse_lunge",
   "name": "Reverse lunge",
   "howTo": "Step one foot back, lower both knees toward 90°, push back up. Alternate legs.",
   "easier": "Hold a chair, smaller step",
   "harder": "Alternate without pausing",
   "seated": false,
   "jumping": false
  },
  {
   "id": "calf_raise",
   "name": "Calf raise",
   "howTo": "Rise onto the balls of your feet, then lower slowly.",
   "easier": "Hold a wall",
   "harder": "Single leg",
   "seated": false,
   "jumping": false
  },
  {
   "id": "arm_circles",
   "name": "Arm circles",
   "howTo": "Arms out to the side, small circles forward, then backward.",
   "easier": "Smaller circles",
   "harder": "Bigger, faster circles",
   "seated": false,
   "jumping": false
  },
  {
   "id": "shoulder_rolls",
   "name": "Shoulder rolls",
   "howTo": "Roll your shoulders up, back and down in slow circles.",
   "easier": "Smaller circles",
   "harder": "Add arm circles",
   "seated": false,
   "jumping": false
  },
  {
   "id": "side_bend",
   "name": "Standing side bend",
   "howTo": "Reach one arm overhead and lean gently to the opposite side. Switch halfway.",
   "easier": "Hand on hip",
   "harder": "Hold each side longer",
   "seated": false,
   "jumping": false
  },
  {
   "id": "cat_cow",
   "name": "Cat–cow",
   "howTo": "Hands on knees (standing) or on all fours: round your back, then gently arch, moving with your breath.",
   "easier": "Seated version",
   "harder": "Slower, deeper breaths",
   "seated": false,
   "jumping": false
  },
  {
   "id": "step_jacks",
   "name": "Step jacks",
   "howTo": "Step one foot out to the side while raising your arms, step back in, alternate sides.",
   "easier": "Arms only to shoulder height",
   "harder": "Jumping jacks",
   "seated": false,
   "jumping": false
  },
  {
   "id": "jumping_jacks",
   "name": "Jumping jacks",
   "howTo": "Jump feet out while raising arms overhead, jump back in.",
   "easier": "Step jacks",
   "harder": "Faster pace",
   "seated": false,
   "jumping": true
  },
  {
   "id": "mountain_climbers",
